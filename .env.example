# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only (cron route + public /recommend insert). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB ---
# v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Cron ---
# Any long random string. Vercel Cron will send it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# --- Site ---
# Used for magic-link email redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: Cloudflare Turnstile (phase 1.5 if spam shows up) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
