# Copy to .env.local and fill in. Never commit .env.local.

# --- Turso ---
# Get from: turso db show <db-name> --url / turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Clerk ---
# Get from: Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- TMDB ---
# v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Cron ---
# Any long random string. Vercel Cron will send it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:4141

# --- Email notifications (Resend — free tier: 3k/month) ---
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_FROM=HAMMFLIX <noreply@yourdomain.com>
# NOTIFICATION_EMAIL=you@example.com

# --- Optional: Cloudflare Turnstile (phase 1.5 if spam shows up) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
