# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# New "publishable" key (starts with sb_publishable_...). Safe for the browser.
# Replaces the legacy anon JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# New "secret" key (starts with sb_secret_...). Server-only; bypasses RLS.
# Used by the cron route and public /recommend insert. Never expose.
# Replaces the legacy service_role JWT key.
SUPABASE_SECRET_KEY=

# --- TMDB ---
# v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Cron ---
# Any long random string. Vercel Cron will send it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# --- Site ---
# Used for magic-link email redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:4141

# --- Optional: Cloudflare Turnstile (phase 1.5 if spam shows up) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
